{
  "name": "poke-multi-manager",
  "version": "1.0.2",
  "description": "Gerenciador Multitelas para Poke Idle World",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win"
  },
  "author": "Desenvolvedor",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.pokemulti.manager",
    "productName": "Poke Multi Manager",
    "publish": [
      {
        "provider": "github",
        "owner": "garagem164",
        "repo": "Multiidle"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Poke Multi Manager"
    }
  }
}
